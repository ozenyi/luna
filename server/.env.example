# Copier vers server/.env — aucun secret réel dans ce fichier.
NODE_ENV=development
PORT=8787
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:4173
DATABASE_URL=postgresql://luna:luna@localhost:5432/luna?schema=public
SESSION_SECRET=changez-moi-session-32-caracteres-min
TRUST_PROXY=1

# Comptes de démonstration (jamais des secrets de production).
# Surchargeables : LUNA_* a priorité sur SEED_*.
LUNA_ADMIN_EMAIL=admin@luna.test
LUNA_ADMIN_PASSWORD=Luna-demo-2026
LUNA_VOYANT_EMAIL=voyant@luna.test
LUNA_VOYANT_PASSWORD=Luna-demo-2026
LUNA_CLIENT_EMAIL=client@luna.test
LUNA_CLIENT_PASSWORD=Luna-demo-2026
# Secret TOTP de développement uniquement (ne pas réutiliser).
SEED_ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP
DEMO_EXPOSE_OTP=true

# Stripe — clés de test uniquement (sk_test_..., whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
PLATFORM_COMMISSION_BPS=3000

# Twilio Voice
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_FROM_NUMBER=
TWILIO_TWIML_APP_SID=

# Audiotel / Media Technologies — adaptateur non activé
AUDIOTEL_API_BASE=
AUDIOTEL_API_KEY=
AUDIOTEL_SERVICE_CODE=

# Chat : websocket (défaut), stream ou sendbird
CHAT_PROVIDER=websocket
STREAM_API_KEY=
STREAM_API_SECRET=
SENDBIRD_APP_ID=
SENDBIRD_API_TOKEN=

# Vidéo : daily (défaut) ou whereby
VIDEO_PROVIDER=daily
DAILY_API_KEY=
WHEREBY_API_KEY=

# Brevo (e-mail + SMS). Twilio reste l'alternative SMS.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=contact@example.com
BREVO_SENDER_NAME=Luna
BREVO_SMS_SENDER=Luna

# Matomo auto-hébergé dans l'UE
MATOMO_URL=
MATOMO_SITE_ID=
MATOMO_TOKEN=

# Rétention (jours)
RETENTION_MESSAGES_DAYS=730
RETENTION_RECORDINGS_DAYS=30
RETENTION_LOGS_DAYS=90
RETENTION_INACTIVE_DAYS=1095
RETENTION_AUDIT_DAYS=1825
